# ─────────────────────────────────────────────
# 环境与密钥（绝不入库）
# ─────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ─────────────────────────────────────────────
# 临时产物隔离区（var/ 全量忽略）
# ─────────────────────────────────────────────
var/

# ─────────────────────────────────────────────
# 持久化数据
# ─────────────────────────────────────────────
storage/*.db
storage/*.db-shm
storage/*.db-wal
storage/*.sqlite
storage/*.sqlite3
storage/backup/

# ─────────────────────────────────────────────
# 产出物
# ─────────────────────────────────────────────
packages/*.zip
packages/*.tar.gz
/public/assets/icons/sprite.svg
/public/assets/css/*.min.css

# ─────────────────────────────────────────────
# 系统与编辑器
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# AI 助手会话数据（IDE 生成，非项目产物）
.codebuddy/

.idea/
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
*.swp
*.swo
*~

# ─────────────────────────────────────────────
# 依赖与缓存
# ─────────────────────────────────────────────
node_modules/
vendor/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─────────────────────────────────────────────
# 日志与调试
# ─────────────────────────────────────────────
*.log
npm-debug.log*
php_errors.log
.xdebug-*
