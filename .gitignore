# ─────────────────────────────────────────────
# 环境与密钥（绝不入库）
# ─────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# 项目内托管 SSH 密钥（.ssh/ 默认全量忽略，仅白名单放行非敏感文件）
# ⚠️ 警告：私钥绝不可入库，此处忽略规则是唯一防线，勿删、勿用 git add -f
.ssh/*
!.ssh/README.md
!.ssh/setup.ps1

# ─────────────────────────────────────────────
# 临时产物隔离区（var/ 全量忽略）
# ─────────────────────────────────────────────
var/

# ─────────────────────────────────────────────
# 持久化数据
# ─────────────────────────────────────────────
storage/*.db
storage/*.db-shm
storage/*.db-wal
storage/*.sqlite
storage/*.sqlite3
storage/backup/

# ─────────────────────────────────────────────
# 产出物（离线合集包与网盘上传清单均不入库）
# ─────────────────────────────────────────────
/packages/*
!/packages/.gitkeep
/public/assets/css/*.min.css

# ─────────────────────────────────────────────
# 系统与编辑器
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# AI 助手会话数据（IDE 生成，非项目产物）
.codebuddy/

.idea/
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
*.swp
*.swo
*~

# ─────────────────────────────────────────────
# 依赖与缓存
# ─────────────────────────────────────────────
node_modules/
vendor/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─────────────────────────────────────────────
# 日志与调试
# ─────────────────────────────────────────────
*.log
npm-debug.log*
php_errors.log
.xdebug-*

# 本地工具缓存（agent-browser / playwright-cli 等技能产生，非项目产物）
.playwright-cli/
