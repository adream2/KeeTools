# 统一换行为 LF（仓库内），检出时按平台
* text=auto eol=lf

# ── 强制 LF ────────────────────────────────────
*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# ── Windows 批处理保持 CRLF ─────────────────────
*.bat   text eol=crlf
*.cmd   text eol=crlf

# ── 二进制（不参与 diff 与换行转换）──────────────
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
*.db    binary

# ── 语言统计（避免文档刷高代码占比）──────────────
docs/**   linguist-documentation
tasks/**  linguist-documentation

# ── 生成产物不计入统计 ──────────────────────────
public/assets/icons/sprite.svg  linguist-generated
