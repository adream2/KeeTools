# ─────────────────────────────────────────────
# KeeTools（课工具）环境变量模板
# 用法：复制为 .env 后按需修改。.env 不纳入版本管控。
# ─────────────────────────────────────────────

# ── 应用 ─────────────────────────────────────
APP_ENV=local                     # local | production
APP_DEBUG=true                    # 生产必须 false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Shanghai

# ── 后台管理员 ───────────────────────────────
# 方式一：账号 + 密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                   # 留空则视为未设置密码

# 方式二：无密码后台（仅限本机 / 内网）
ADMIN_PASSWORDLESS=false          # true = 跳过密码校验
ADMIN_PASSWORDLESS_IPS=127.0.0.1,::1   # 仅这些 IP 允许无密码登录（不可填 *）

# ── 数据库 ───────────────────────────────────
DB_PATH=storage/app.db
STATS_DB_PATH=storage/stats.db

# ── 安全 ─────────────────────────────────────
APP_KEY=                          # 32 字节随机串，用于签名 / 加密
                                  # 生成：php -r "echo bin2hex(random_bytes(32));"
SESSION_NAME=et_session
SESSION_LIFETIME=7200             # 秒

# ── 站点 ─────────────────────────────────────
SITE_NAME=KeeTools
SITE_DESCRIPTION=课工具 KeeTools — 面向中小学老师的免费课堂工具集，单文件即开即用，断网也能用
SITE_DOMAIN=localhost             # check_no_external.py 的白名单域名

# ── 下载开关 ─────────────────────────────────
DOWNLOAD_DIRECT_ENABLED=true      # 单文件直接下载总开关

# ─────────────────────────────────────────────
# 生产部署前自检（APP_ENV=production 时程序强制校验）
#   [ ] APP_DEBUG=false
#   [ ] APP_KEY 非空且为 64 位十六进制
#   [ ] ADMIN_PASSWORD 已设置，或 ADMIN_PASSWORDLESS=true 且 IPS 为具体 IP
#   [ ] SITE_DOMAIN 为真实域名
#   [ ] .env 权限设为 600（Linux）或仅管理员可读（Windows）
#   [ ] Web 根指向 public/，var/ storage/ src/ tools/ docs/ 不可 HTTP 访问
# ─────────────────────────────────────────────
